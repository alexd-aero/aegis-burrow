#!/usr/bin/env bash
# burrow: Burrow, the tunnel engine of Aegis × Burrow, on the command line.
#
#   burrow status | list | on | off
#   burrow publish PORT [--name N] [--sub NAME] [--public] [--host H]
#   burrow rename PORT NAME          its own address: NAME.<zone> ("" = tunnel-PORT-…)
#   burrow unpublish PORT
#
# The same as `aegis burrow …`; it talks to data/control.sock.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
case "${1:-}" in -h|--help|help) sed -n '2,9p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;; esac
exec "$(dirname "$SELF")/aegis" burrow "$@"
