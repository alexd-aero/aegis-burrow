#!/usr/bin/env bash
# aegis: install, set up, run and look after Aegis × Burrow.
#
#   aegis                            the home screen: what's running, what next (arrow keys)
#   aegis install [--port N] [--bind ADDR] [--home DIR] [--termix] [--no-start] [--setup cli|browser]
#   aegis setup                      set it up right here: the login, the pack, a domain
#   aegis status [--json] | open | url | setup-link | logs [-f] | version
#   aegis start | stop | restart
#   aegis tunnels                    manage tunnels with arrow keys
#   aegis domain [link | rename NAME | unlink]
#   aegis passwd                     a new login (every browser is signed out)
#   aegis update [--check] | auto on|off
#   aegis upgrade                    copy this checkout's code over the installed one, restart
#   aegis uninstall [--purge]        stop and remove; --purge also deletes data and the login
#   aegis termix install | remove    Termix in Docker, behind the same login
#   aegis doctor [--fix]             check (and fetch) Node and cloudflared
#   aegis serveo on | off | url      a public https link to the dashboard (serveo.net)
#   aegis burrow status | list | on | off | publish PORT … | unpublish PORT | rename PORT NAME
#
# Layout (AEGIS_HOME, default ~/.local/share/aegis):
#   app/          the code (aegis/, burrow/, public/, bin/), copied from a checkout
#   node/         a private Node.js, only when the machine has none >= 18.17
#   bin/          cloudflared, only when the machine has none
#   config.json   secret.key   data/   (see aegis/config.mjs)
# ~/.config/aegis/aegis.json says where all that is, for other apps
# (Selkies Forge reads it), and ~/.config/aegis/integrations/ is where they
# plug in.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SRC_DIR="$(dirname "$SELF_DIR")"
CONFIG_DIR="${AEGIS_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/aegis}"
DISCOVERY="$CONFIG_DIR/aegis.json"
NODE_MIN="18.17.0"
UNIT="aegis.service"

c() { if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then printf '\033[%sm%s\033[0m' "$1" "$2"; else printf '%s' "$2"; fi; }
# say ok warn die, banner, spinner, bar, ask, confirm, menu_choose…
# shellcheck source=ui.sh
. "$SELF_DIR/ui.sh"
# progress for Selkies Forge (it reads "::progress N text" lines); harmless elsewhere
progress() { [ -n "${FORGE_ADDON_ID:-}" ] && echo "::progress $1 $2"; say "$2"; }

# Where an installed Aegis lives: the discovery file wins, then the default.
discovered() {
  [ -f "$DISCOVERY" ] || return 1
  python3 - "$DISCOVERY" "$1" 2>/dev/null <<'PY' || sed -n "s/.*\"$1\": *\"\([^\"]*\)\".*/\1/p" "$DISCOVERY" | head -1
import json, sys
d = json.load(open(sys.argv[1]))
v = d
for k in sys.argv[2].split("."):
    v = (v or {}).get(k) if isinstance(v, dict) else None
print(v if v is not None else "")
PY
}
AEGIS_HOME="${AEGIS_HOME:-$(discovered home || true)}"
AEGIS_HOME="${AEGIS_HOME:-$HOME/.local/share/aegis}"
APP="$AEGIS_HOME/app"

arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo x64 ;;
    aarch64|arm64) echo arm64 ;;
    armv7l|armv7*) echo armv7l ;;
    *) uname -m ;;
  esac
}

ver_ge() {  # ver_ge 20.1.0 18.17.0
  [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" = "$2" ]
}

# ---------------------------------------------------------------- node
node_ok() { [ -x "$1" ] && ver_ge "$("$1" -v 2>/dev/null | tr -d v)" "$NODE_MIN"; }
find_node() {
  local n
  for n in "${AEGIS_NODE:-}" "$AEGIS_HOME/node/bin/node" "$(command -v node 2>/dev/null || true)" \
           $(ls -d "$HOME"/.nvm/versions/node/*/bin/node 2>/dev/null | sort -rV) \
           /usr/local/bin/node /usr/bin/node; do
    [ -n "$n" ] && node_ok "$n" && { readlink -f "$n"; return 0; }
  done
  return 1
}
fetch_node() {
  local a; a="$(arch)"
  case "$a" in x64|arm64|armv7l) ;; *) die "no Node.js build for $(uname -m); install Node >= $NODE_MIN yourself" ;; esac
  command -v curl >/dev/null || die "curl is needed to download Node.js"
  progress 15 "downloading Node.js 22 for linux-$a…"
  local base="https://nodejs.org/dist/latest-v22.x" file
  file="$(curl -fsSL "$base/SHASUMS256.txt" | awk -v a="linux-$a.tar.xz" '$2 ~ a"$" {print $2; exit}')"
  [ -n "$file" ] || die "could not find a Node.js download for linux-$a"
  local tmp; tmp="$(mktemp -d)"
  curl -fsSL "$base/$file" -o "$tmp/$file"
  (cd "$tmp" && curl -fsSL "$base/SHASUMS256.txt" | grep " $file\$" | sha256sum -c - >/dev/null) || die "Node.js download failed its checksum"
  rm -rf "$AEGIS_HOME/node" && mkdir -p "$AEGIS_HOME/node"
  tar -xJf "$tmp/$file" -C "$AEGIS_HOME/node" --strip-components=1
  rm -rf "$tmp"
  ok "Node.js $("$AEGIS_HOME/node/bin/node" -v) in $AEGIS_HOME/node"
}

# ---------------------------------------------------------------- cloudflared
find_cloudflared() {
  local c2
  for c2 in "$AEGIS_HOME/bin/cloudflared" "$(command -v cloudflared 2>/dev/null || true)" /usr/local/bin/cloudflared /usr/bin/cloudflared; do
    [ -n "$c2" ] && [ -x "$c2" ] && { echo "$c2"; return 0; }
  done
  return 1
}
fetch_cloudflared() {
  local a
  case "$(uname -m)" in
    x86_64|amd64) a=amd64 ;; aarch64|arm64) a=arm64 ;; armv7l|armv7*|armv6l) a=arm ;; i686|i386) a=386 ;;
    *) warn "no cloudflared build for $(uname -m)"; return 1 ;;
  esac
  progress 30 "downloading cloudflared (linux-$a)…"
  mkdir -p "$AEGIS_HOME/bin"
  curl -fsSL "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-$a" -o "$AEGIS_HOME/bin/cloudflared.new" \
    && chmod +x "$AEGIS_HOME/bin/cloudflared.new" && mv "$AEGIS_HOME/bin/cloudflared.new" "$AEGIS_HOME/bin/cloudflared" \
    && ok "cloudflared $("$AEGIS_HOME/bin/cloudflared" --version 2>/dev/null | awk '{print $3}') in $AEGIS_HOME/bin" \
    || { warn "could not download cloudflared; tunnels need it"; return 1; }
}

# ---------------------------------------------------------------- config
json_get() {  # json_get FILE KEY.PATH  (needs node)
  "$NODE" -e 'const [f,k]=process.argv.slice(1);try{let v=JSON.parse(require("fs").readFileSync(f,"utf8"));for(const p of k.split("."))v=v==null?undefined:v[p];process.stdout.write(v==null?"":typeof v==="object"?JSON.stringify(v):String(v))}catch{}' "$1" "$2"
}
json_merge() {  # json_merge FILE '{"a":1}'  (shallow merge, creates the file, mode 600)
  "$NODE" -e 'const fs=require("fs");const [f,p]=process.argv.slice(1);let d={};try{d=JSON.parse(fs.readFileSync(f,"utf8"))}catch{};Object.assign(d,JSON.parse(p));fs.mkdirSync(require("path").dirname(f),{recursive:true});fs.writeFileSync(f+".tmp",JSON.stringify(d,null,2)+"\n",{mode:0o600});fs.renameSync(f+".tmp",f)' "$1" "$2"
}
# The value the server runs with: data/state.json wins over config.json,
# top-level key by top-level key (an explicit null in state.json counts).
setting() {
  "$NODE" -e '
    const fs = require("fs"); const [home, k] = process.argv.slice(1);
    const rd = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return {}; } };
    const base = rd(home + "/config.json"), state = rd(home + "/data/state.json");
    if (base.mainHost && base.tunnelId && !base.domain) base.domain = { mainHost: base.mainHost };   // older gate layout
    if (!state.auth && base.hash) state.auth = { hash: base.hash };
    const top = k.split(".")[0];
    let v = top in state ? state : base;
    for (const p of k.split(".")) v = v == null ? undefined : v[p];
    process.stdout.write(v == null ? "" : typeof v === "object" ? JSON.stringify(v) : String(v));' "$AEGIS_HOME" "$1"
}
listen_url() {
  local host port tls
  host="$(setting listen.host)"; port="$(setting listen.port)"; tls="$(setting tls)"
  case "${host:-127.0.0.1}" in 0.0.0.0|::|"") host=127.0.0.1 ;; esac
  printf '%s://%s:%s' "$([ -n "$tls" ] && echo https || echo http)" "${host:-127.0.0.1}" "${port:-4310}"
}
dashboard_url() { local m; m="$(setting domain.mainHost)"; if [ -n "$m" ]; then printf 'https://%s/' "$m"; else printf '%s/' "$(listen_url)"; fi; }
setup_needed() { [ -z "$(setting auth.hash)" ]; }
# The serveo link (burrow/serveo.mjs): on by default until a domain is linked.
serveo_wanted() { [ "$(setting serveo)" != false ]; }
serveo_url() { json_get "$AEGIS_HOME/data/runtime.json" serveo; }
wait_serveo() {  # the server opens it a few seconds after it starts
  local i; serveo_wanted || return 1
  for i in $(seq 1 50); do [ -n "$(serveo_url)" ] && return 0; sleep 0.5; done; return 1
}
# links PATH: every address it answers on, one per line, PATH appended
links() {
  local p="${1:-}" s m; m="$(setting domain.mainHost)"
  if [ -n "$m" ]; then linkline domain "https://$m/$p"; fi
  linkline local "$(listen_url)/$p"
  if serveo_wanted; then
    s="$(serveo_url)"
    if [ -n "$s" ]; then linkline serveo "$s$p"
    else printf '    %s%-7s%s %snot up yet; see: aegis serveo url%s\n' "$DIM" serveo "$NC" "$DIM" "$NC"; fi
  fi
  return 0
}
setup_path() { printf '__gate/setup'; }   # no token: open for 30 min after start (aegis restart reopens)
setup_link() { local t; t="$(setting setupToken)"; printf '%s/__gate/setup%s' "$(listen_url)" "${t:+?t=$t}"; }

# ---------------------------------------------------------------- service
service_scope() { discovered service.scope || true; }
service_name() { local n; n="$(discovered service.name || true)"; echo "${n:-$UNIT}"; }
systemd_user_ok() { command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; }

svc() {  # svc start|stop|restart|is-active
  local scope name; scope="$(service_scope)"; name="$(service_name)"
  case "$scope" in
    system) if [ "$1" = is-active ]; then systemctl is-active --quiet "$name"; else sudo -n systemctl "$1" "$name" 2>/dev/null || sudo systemctl "$1" "$name"; fi ;;
    user) if [ "$1" = is-active ]; then systemctl --user is-active --quiet "$name"; else systemctl --user "$1" "$name"; fi ;;
    # manual: something else runs it (a container, a dev shell); we never touch it
    manual) if [ "$1" = is-active ]; then healthy; else say "it runs under your own supervisor: $1 it there"; fi ;;
    *) bg_svc "$1" ;;
  esac
}

# No systemd user session: a plain background process, restarted at boot by cron.
bg_svc() {
  local pidf="$AEGIS_HOME/aegis.pid" pid
  pid="$(cat "$pidf" 2>/dev/null || true)"
  case "$1" in
    is-active) [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null ;;
    stop) [ -n "$pid" ] && kill "$pid" 2>/dev/null || true; rm -f "$pidf" ;;
    start) bg_svc is-active && return 0
           mkdir -p "$AEGIS_HOME/logs"
           AEGIS_HOME="$AEGIS_HOME" nohup "$NODE" "$APP/aegis/server.mjs" >> "$AEGIS_HOME/logs/aegis.log" 2>&1 &
           echo $! > "$pidf" ;;
    restart) bg_svc stop; sleep 1; bg_svc start ;;
  esac
}

install_service() {
  if systemd_user_ok; then
    local unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"
    mkdir -p "$(dirname "$unit")"
    cat > "$unit" <<EOF
[Unit]
Description=Aegis × Burrow: a post-quantum gate and tunnels
Documentation=https://github.com/alexd-aero/aegis-burrow
After=network-online.target

[Service]
Type=simple
Environment=AEGIS_HOME=$AEGIS_HOME
Environment=AEGIS_CONFIG_DIR=$CONFIG_DIR
Environment=PATH=$(dirname "$NODE"):$AEGIS_HOME/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=$NODE $APP/aegis/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable "$UNIT" >/dev/null 2>&1 || true
    if command -v loginctl >/dev/null && [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != yes ]; then
      loginctl enable-linger "$USER" 2>/dev/null || sudo -n loginctl enable-linger "$USER" 2>/dev/null \
        || warn "Aegis stops when you log out until you run: sudo loginctl enable-linger $USER"
    fi
    echo user
  else
    if command -v crontab >/dev/null; then
      ( crontab -l 2>/dev/null | grep -v '# aegis-boot' || true
        echo "@reboot sleep 15; AEGIS_HOME=$AEGIS_HOME $APP/bin/aegis start >/dev/null 2>&1 # aegis-boot" ) | crontab -
    fi
    echo background
  fi
}

# A system service someone wrote by hand still starts the old layout
# (app/server/server.mjs): point it at app/aegis/server.mjs.
migrate_system_unit() {
  local f; f="$(systemctl show -p FragmentPath --value "$1" 2>/dev/null || true)"
  [ -n "$f" ] && [ -f "$f" ] && grep -q "$APP/server/server.mjs" "$f" || return 0
  if sudo -n sed -i "s#$APP/server/server.mjs#$APP/aegis/server.mjs#g" "$f" 2>/dev/null && sudo -n systemctl daemon-reload 2>/dev/null; then
    ok "$1 now starts $APP/aegis/server.mjs"
  else
    warn "update $f yourself: ExecStart should run $APP/aegis/server.mjs"
  fi
}

write_discovery() {
  local scope="$1" name="$2"
  mkdir -p "$CONFIG_DIR/integrations"
  "$NODE" -e '
    const fs = require("fs"); const [f, home, app, scope, name, url, dash, ver] = process.argv.slice(1);
    fs.writeFileSync(f + ".tmp", JSON.stringify({ app: "aegis-burrow", engine: "burrow", version: ver, home, code: app, url, dashboard: dash,
      service: { scope, name }, cli: app + "/bin/aegis", updated: Math.floor(Date.now() / 1000) }, null, 2) + "\n");
    fs.renameSync(f + ".tmp", f);' "$DISCOVERY" "$AEGIS_HOME" "$APP" "$scope" "$name" "$(listen_url)/" "$(dashboard_url)" "$(json_get "$APP/package.json" version)"
}

# Is Aegis answering? Asked with Node, not curl: with `tls` set Aegis only
# accepts the post-quantum key exchange, which many curl builds can't speak.
healthy() {
  "$NODE" -e '
    const u = new URL(process.argv[1]);
    const mod = require(u.protocol === "https:" ? "https" : "http");
    const r = mod.get(u, { rejectUnauthorized: false, timeout: 3000 }, (res) => process.exit(res.statusCode === 200 ? 0 : 1));
    r.on("error", () => process.exit(1)); r.on("timeout", () => { r.destroy(); process.exit(1); });' "$(listen_url)/__gate/health" 2>/dev/null
}
wait_healthy() {
  local i
  for i in $(seq 1 40); do
    healthy && return 0
    sleep 0.5
  done
  return 1
}

copy_app() {
  [ -f "$SRC_DIR/aegis/server.mjs" ] || die "run this from an Aegis × Burrow checkout (no aegis/server.mjs next to bin/)"
  [ "$(readlink -f "$SRC_DIR")" = "$(readlink -f "$APP" 2>/dev/null || true)" ] && return 0
  mkdir -p "$AEGIS_HOME"
  rm -rf "$APP.new"
  mkdir -p "$APP.new"
  cp -a "$SRC_DIR/aegis" "$SRC_DIR/burrow" "$SRC_DIR/public" "$SRC_DIR/bin" "$SRC_DIR/package.json" "$APP.new/"
  for f in README.md LICENSE logo.svg forge-addon.json forge; do [ -e "$SRC_DIR/$f" ] && cp -a "$SRC_DIR/$f" "$APP.new/"; done
  rm -rf "$APP.old"; [ -d "$APP" ] && mv "$APP" "$APP.old"
  mv "$APP.new" "$APP"; rm -rf "$APP.old"
}

# ---------------------------------------------------------------- commands
cmd_install() {
  local port="" bind="" termix=0 start=1 setup_mode=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --port) port="$2"; shift ;;
      --bind) bind="$2"; shift ;;
      --home) AEGIS_HOME="$2"; APP="$AEGIS_HOME/app"; shift ;;
      --termix) termix=1 ;;
      --no-start) start=0 ;;
      --setup) setup_mode="${2:-}"; shift; case "$setup_mode" in cli|browser) ;; *) die "--setup cli | browser" ;; esac ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  if [ -n "${FORGE_ADDON_ID:-}" ]; then echo; echo "  Aegis × Burrow $(src_version)"; echo
  else banner "$(src_version)"; title "Installing" "into $AEGIS_HOME"; fi
  progress 5 "installing into $AEGIS_HOME"
  mkdir -p "$AEGIS_HOME/data"; chmod 700 "$AEGIS_HOME" "$AEGIS_HOME/data"
  NODE="$(find_node || true)"
  if [ -z "$NODE" ]; then fetch_node; NODE="$AEGIS_HOME/node/bin/node"; fi
  ok "Node.js $("$NODE" -v) at $NODE"
  find_cloudflared >/dev/null || fetch_cloudflared || true
  [ -n "$(find_cloudflared || true)" ] && ok "cloudflared at $(find_cloudflared)"

  progress 45 "copying the code"
  local was_running=0
  svc is-active 2>/dev/null && was_running=1
  copy_app
  ok "code in $APP"

  local cfg="$AEGIS_HOME/config.json"
  if [ ! -f "$cfg" ]; then
    local token; token="$("$NODE" -e 'process.stdout.write(require("crypto").randomBytes(18).toString("base64url"))')"
    json_merge "$cfg" "{\"listen\":{\"host\":\"${bind:-127.0.0.1}\",\"port\":${port:-4310}},\"setupToken\":\"$token\"}"
    ok "new config.json (dashboard on ${bind:-127.0.0.1}:${port:-4310})"
  elif [ -n "$port$bind" ]; then
    local h p
    h="${bind:-$(json_get "$cfg" listen.host)}"; p="${port:-$(json_get "$cfg" listen.port)}"
    json_merge "$cfg" "{\"listen\":{\"host\":\"${h:-127.0.0.1}\",\"port\":${p:-4310}}}"
  fi
  [ -f "$AEGIS_HOME/secret.key" ] || { head -c 32 /dev/urandom > "$AEGIS_HOME/secret.key"; chmod 600 "$AEGIS_HOME/secret.key"; }

  progress 60 "setting up the service"
  local scope name
  scope="$(service_scope)"; name="$(service_name)"
  case "$scope" in
    system) migrate_system_unit "$name" ;;
    manual) ;;
    *) scope="$(install_service)"; name="$UNIT" ;;
  esac
  write_discovery "$scope" "$name"
  mkdir -p "$HOME/.local/bin" && ln -sf "$APP/bin/aegis" "$HOME/.local/bin/aegis" && ln -sf "$APP/bin/burrow" "$HOME/.local/bin/burrow"

  if [ "$start" = 1 ]; then
    progress 75 "starting Aegis × Burrow"
    if [ "$was_running" = 1 ]; then svc restart; else svc start; fi
    wait_healthy || die "Aegis × Burrow did not come up. See: aegis logs"
    ok "running at $(listen_url)"
  fi
  write_discovery "$scope" "$name"

  if [ "$termix" = 1 ]; then cmd_termix install || warn "Termix was not installed; add it later from Settings"; fi

  progress 100 "done"
  echo
  [ "$start" = 1 ] && serveo_wanted && { progress 100 "opening a serveo link"; wait_serveo || true; }
  if setup_needed; then
    # Set it up here, or in a browser: asked when someone is at the keyboard
    if [ "$start" = 1 ] && [ "$setup_mode" != browser ] && interactive; then
      if [ -z "$setup_mode" ]; then
        title "Set it up" "the login, the pack and (if you like) your own domain"
        setup_mode="$(menu_choose "Where would you like to set it up?" \
          $'cli\tHere, in this terminal\tstep by step, a minute or two' \
          $'browser\tIn a browser\ton this machine, or your phone through the serveo link')" || setup_mode=browser
      fi
      if [ "$setup_mode" = cli ]; then cmd_setup; return 0; fi
    fi
    echo "  Create your login in a browser, from this machine or anywhere:"
    links "$(setup_path)"
    dim "The setup page is open from anywhere for 30 minutes (aegis restart opens it again). Or run: aegis setup"
    [ -n "${FORGE_ADDON_ID:-}" ] && echo "::open $(setup_link)"
  else
    echo "  Dashboard:"
    links ""
    [ -n "${FORGE_ADDON_ID:-}" ] && echo "::open $(dashboard_url)"
  fi
  echo
}

cmd_uninstall() {
  local purge=0
  [ "${1:-}" = "--purge" ] && purge=1
  NODE="$(find_node || true)"
  if [ "$(service_scope)" = system ] || [ "$(service_scope)" = manual ]; then
    die "this Aegis runs as the system service $(service_name); stop and remove that unit yourself"
  fi
  svc stop 2>/dev/null || true
  if systemd_user_ok; then
    systemctl --user disable "$UNIT" >/dev/null 2>&1 || true
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"
    systemctl --user daemon-reload || true
  fi
  command -v crontab >/dev/null && (crontab -l 2>/dev/null | grep -v '# aegis-boot' | crontab -) 2>/dev/null || true
  # Quick tunnels and the connector are children of the server and stop with it.
  # A Termix Aegis installed is left running; `aegis termix remove` first if you want it gone.
  rm -f "$HOME/.local/bin/aegis" "$HOME/.local/bin/burrow" "$DISCOVERY"
  if [ "$purge" = 1 ]; then
    warn "deleting $AEGIS_HOME (login, tunnels, Cloudflare credentials)"
    rm -rf "$AEGIS_HOME"
  else
    rm -rf "$APP" "$AEGIS_HOME/node"
    say "kept your login and tunnels in $AEGIS_HOME (use --purge to delete them)"
  fi
  ok "Aegis × Burrow is uninstalled"
}

cmd_status() {
  local json=0; [ "${1:-}" = "--json" ] && json=1
  local state="not-installed" ver="" url="" dash="" setup=false link="" burrow=true
  if [ -f "$APP/aegis/server.mjs" ]; then
    NODE="$(find_node || true)"
    ver="$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$APP/package.json" | head -1)"
    if [ -n "$NODE" ]; then
      url="$(listen_url)/"; dash="$(dashboard_url)"
      if healthy; then state=running; else state=stopped; fi
      if setup_needed; then setup=true; link="$(setup_link)"; fi
      [ "$(setting modules.burrow)" = false ] && burrow=false
    else state=broken; fi
  fi
  if [ "$json" = 1 ]; then
    local sv=""; [ -n "${NODE:-}" ] && [ "$state" = running ] && sv="$(serveo_url)"
    printf '{"state":"%s","version":"%s","url":"%s","dashboard":"%s","setup_needed":%s,"setup_url":"%s","home":"%s","burrow":%s,"serveo":"%s"}\n' \
      "$state" "$ver" "$url" "$dash" "$setup" "$link" "$AEGIS_HOME" "$burrow" "$sv"
  else
    case "$state" in
      not-installed) say "Aegis × Burrow is not installed here: aegis install"; return 0 ;;
      broken) bad "Node.js is missing: aegis doctor --fix"; return 1 ;;
    esac
    cli status || true
    if [ "$state" = running ] && [ "$setup" = true ]; then printf '\n'; info "create the login: ${B}aegis setup${NC} here, or in a browser:"; links "$(setup_path)"; fi
    if [ "$state" != running ]; then printf '\n'; info "start it: aegis start"; return 1; fi
  fi
}

cmd_termix() {
  NODE="${NODE:-$(find_node || true)}"
  [ -n "$NODE" ] || die "Node.js is missing; run aegis install"
  case "${1:-}" in
    install)
      [ -n "$(setting termix.upstream)" ] && { ok "Termix is already set up"; return 0; }
      docker version >/dev/null 2>&1 || die "Docker is not available to $USER"
      local port=4300
      while (exec 3<>/dev/tcp/127.0.0.1/$port) 2>/dev/null; do port=$((port + 1)); done
      progress 85 "pulling Termix (once, a few hundred MB)…"
      docker pull -q ghcr.io/lukegus/termix:latest >/dev/null
      docker rm -f aegis-termix >/dev/null 2>&1 || true
      docker run -d --name aegis-termix --restart unless-stopped -p "127.0.0.1:$port:8080" -e PORT=8080 \
        -v aegis-termix-data:/app/data --label io.aegis.app=termix ghcr.io/lukegus/termix:latest >/dev/null
      json_merge "$AEGIS_HOME/data/state.json" "{\"termix\":{\"upstream\":\"http://127.0.0.1:$port\",\"container\":\"aegis-termix\"}}"
      svc restart >/dev/null 2>&1 || true
      ok "Termix on 127.0.0.1:$port, behind Aegis's login"
      ;;
    remove)
      docker rm -f aegis-termix >/dev/null 2>&1 || true
      json_merge "$AEGIS_HOME/data/state.json" '{"termix":null}'
      svc restart >/dev/null 2>&1 || true
      ok "Termix removed (its data volume aegis-termix-data is kept)"
      ;;
    *) die "aegis termix install | remove" ;;
  esac
}

cmd_doctor() {
  local fix=0 bad=0; [ "${1:-}" = "--fix" ] && fix=1
  if NODE="$(find_node)"; then ok "Node.js $("$NODE" -v) ($NODE)"; else
    warn "no Node.js >= $NODE_MIN"; bad=1; [ "$fix" = 1 ] && { fetch_node; bad=0; }; fi
  if find_cloudflared >/dev/null; then ok "cloudflared ($(find_cloudflared))"; else
    warn "no cloudflared (tunnels need it)"; bad=1; [ "$fix" = 1 ] && fetch_cloudflared && bad=0; fi
  if docker version >/dev/null 2>&1; then ok "Docker (for Termix and the port list)"; else say "no Docker access: Termix and container names in the port list are unavailable"; fi
  if [ -f "$APP/aegis/server.mjs" ]; then cmd_status || bad=1; else say "not installed yet: aegis install"; fi
  return $bad
}

cmd_logs() {
  case "$(service_scope)" in
    system) journalctl -u "$(service_name)" --no-pager -n 200 "$@" ;;
    user) journalctl --user -u "$UNIT" --no-pager -n 200 "$@" ;;
    *) tail -n 200 "$@" "$AEGIS_HOME/logs/aegis.log" ;;
  esac
}

# ---------------------------------------------------------------- burrow
# Burrow, the tunnel engine, through its control socket (burrow_call, below).
cmd_burrow() {
  local out
  case "${1:-status}" in
    status)
      out="$(burrow_call GET /status)" || die "$out"
      "$NODE" -e 'const s=JSON.parse(process.argv[1]);console.log(`  Burrow ${s.version}: ${s.on?"on":"off"}, ${s.tunnels} tunnel${s.tunnels===1?"":"s"} (${s.enabled} live), ${s.mode==="domain"?"tunnel-PORT on "+s.mainHost.split(".").slice(1).join("."):"quick tunnels (trycloudflare.com)"}`)' "$out" ;;
    list)
      out="$(burrow_call GET /tunnels)" || die "$out"
      "$NODE" -e 'const j=JSON.parse(process.argv[1]);if(!j.tunnels.length)console.log("  no tunnels");for(const t of j.tunnels)console.log(`  ${String(t.port).padEnd(6)}${(t.enabled?"live  ":"paused")}  ${t.access.padEnd(6)}  ${(t.url||"(starting)").padEnd(52)} ${t.name||""}`)' "$out" ;;
    on|off)
      out="$(burrow_call POST /module "{\"burrow\":$([ "$1" = on ] && echo true || echo false)}")" || die "$out"
      ok "Burrow is $1" ;;
    publish)
      local port="${2:-}" name="" access=login host=127.0.0.1 sub=""; shift 2 || true
      [[ "$port" =~ ^[0-9]+$ ]] || die "aegis burrow publish PORT [--name N] [--sub NAME] [--public] [--host H]"
      while [ $# -gt 0 ]; do case "$1" in --name) name="$2"; shift ;; --sub) sub="$2"; shift ;; --public) access=public ;; --host) host="$2"; shift ;; *) die "unknown option $1" ;; esac; shift; done
      out="$(burrow_call POST /tunnels "$("$NODE" -e 'const [p,n,a,h,s]=process.argv.slice(1);process.stdout.write(JSON.stringify({port:+p,targetHost:h,targetPort:+p,name:n,access:a,sub:s||null}))' "$port" "$name" "$access" "$host" "$sub")")" || die "$out"
      ok "published: $("$NODE" -e 'const t=JSON.parse(process.argv[1]);process.stdout.write(t.url||"(the address is on its way: aegis burrow list)")' "$out")" ;;
    unpublish)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "aegis burrow unpublish PORT"
      out="$(burrow_call DELETE "/tunnels/$2")" || die "$out"
      ok "tunnel $2 removed" ;;
    rename)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "aegis burrow rename PORT NAME   (NAME \"\" goes back to tunnel-PORT-…)"
      out="$(burrow_call PATCH "/tunnels/$2" "$("$NODE" -e 'process.stdout.write(JSON.stringify({sub:process.argv[1]||null}))' "${3:-}")")" || die "$out"
      ok "tunnel $2: $("$NODE" -e 'const t=JSON.parse(process.argv[1]);process.stdout.write(t.url||"(the address is on its way)")' "$out")" ;;
    *) die "aegis burrow status | list | on | off | publish PORT | unpublish PORT | rename PORT NAME" ;;
  esac
}

# ---------------------------------------------------------------- the running server
# bin/cli.mjs talks to it over data/control.sock (mode 600: this user only).
cli() { AEGIS_HOME="$AEGIS_HOME" AEGIS_COLOR="$COLOR" "$NODE" "$SELF_DIR/cli.mjs" "$@"; }
burrow_call() { cli call "$@"; }       # burrow_call METHOD PATH [JSON | -]  (prints the body, or the error)
jget() { cli get "$1"; }                 # jget KEY < json
running() { [ -S "$AEGIS_HOME/data/control.sock" ] && cli call GET /status >/dev/null 2>&1; }
src_version() { sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$SRC_DIR/package.json" | head -1; }
app_version() { sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$APP/package.json" 2>/dev/null | head -1; }
ensure_running() {
  running && return 0
  spin_start "starting Aegis × Burrow"
  svc start >/dev/null 2>&1 || true
  local i; for i in $(seq 1 40); do running && break; sleep 0.5; done
  spin_stop
  running || die "Aegis × Burrow isn't answering. See: aegis logs"
}
open_url() {  # open a link in this machine's browser, when it has one
  if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1 & fi
  return 0
}

# ---------------------------------------------------------------- aegis setup
# Everything the browser's first run does, as questions in this terminal.
cmd_setup() {
  need_installed
  interactive || die "aegis setup asks questions: run it in a terminal, or set it up in a browser (aegis setup-link)"
  ensure_running
  local out u p p2
  if setup_needed; then
    title "1 · Your login" "one username and password for the dashboard, Termix and every protected tunnel"
    while :; do
      u="$(ask "Username" "${USER:-admin}")"
      if [[ "$u" =~ ^[A-Za-z0-9._@-]{2,64}$ ]]; then break; fi
      bad "2-64 letters, digits, . _ @ -"
    done
    while :; do
      p="$(ask_secret "Password (10+ characters)")"
      if [ "${#p}" -lt 10 ]; then bad "use at least 10 characters"; continue; fi
      p2="$(ask_secret "The same again")"
      if [ "$p" = "$p2" ]; then break; fi
      bad "the two differ; once more"
    done
    # the password goes to the server on stdin, never on a command line
    out="$(U="$u" P="$p" "$NODE" -e 'process.stdout.write(JSON.stringify({username: process.env.U, password: process.env.P}))' | burrow_call POST /setup -)" || die "$out"
    p=""; p2=""
    ok "login created for ${B}$u${NC}"
  else
    title "1 · Your login"
    ok "already set up ($(setting auth.username)); a new one: aegis passwd"
  fi
  setup_pack
  setup_domain
  title "You're all set" "sign in with your login at any of these"
  links ""
  printf '\n  %sCome back any time:%s %saegis%s  %s(the home screen: status, tunnels, domain, updates)%s\n\n' "$B" "$NC" "$MNT" "$NC" "$DIM" "$NC"
}

setup_pack() {
  title "2 · The pack" "each part is optional; what's already here is linked, not installed twice"
  local js out port forge_here termix_set burrow=true termix=null forge=false tu tp
  spin_start "looking at what's on this machine"
  js="$(burrow_call GET /pack)" || { spin_stop; die "$js"; }
  spin_stop
  port="$(printf '%s' "$js" | jget found.termix.port)"
  forge_here="$(printf '%s' "$js" | jget forge)"
  termix_set="$(printf '%s' "$js" | jget termix)"
  local old; old="$(printf '%s' "$js" | jget found.oldBurrow.home)"
  if [ -n "$old" ]; then
    warn "an older standalone Burrow is also here ($old); this one replaces it, and its tunnels aren't moved over"
    dim "remove it when you're ready: $(printf '%s' "$js" | jget found.oldBurrow.cli) uninstall"
  fi
  confirm "Keep Burrow on? (any port on its own HTTPS address, behind this login)" y || burrow=false
  if [ "$termix_set" = true ]; then ok "Termix is already set up"
  elif [ -n "$port" ]; then
    if confirm "Termix is running on port $port. Put it behind this login?" y; then termix='{"link":true}'; fi
  elif docker version >/dev/null 2>&1; then
    if confirm "Install Termix? (SSH terminals and files in the browser; one Docker container)" n; then
      info "Termix has accounts of its own; this one becomes its admin"
      while :; do tu="$(ask "  Termix username" "${USER:-admin}")"; [[ "$tu" =~ ^[A-Za-z0-9._@-]{2,64}$ ]] && break; bad "2-64 letters, digits, . _ @ -"; done
      while :; do tp="$(ask_secret "  Termix password (8+)")"; [ "${#tp}" -ge 8 ] && break; bad "at least 8 characters"; done
      termix="tx"
    fi
  else say "Termix needs Docker, which $USER can't reach right now; skipped"; fi
  if [ "$forge_here" = true ]; then ok "Selkies Forge is already installed"
  elif confirm "Install Selkies Forge? (150+ Linux desktops in the browser; a big download)" n; then forge=true; fi
  out="$(B_ON="$burrow" TX="$termix" TU="${tu:-}" TP="${tp:-}" FG="$forge" "$NODE" -e '
    const e = process.env;
    const termix = e.TX === "tx" ? { username: e.TU, password: e.TP } : JSON.parse(e.TX);
    process.stdout.write(JSON.stringify({ burrow: e.B_ON === "true", forge: e.FG === "true", termix }));' | burrow_call POST /pack -)" || die "$out"
  tp=""
  echo
  if cli pack-wait; then ok "the pack is ready"; else warn "something didn't finish; see above, or open Settings in the browser"; fi
}

setup_domain() {
  title "3 · Your own address (optional)" "a Cloudflare domain: the dashboard at NAME.your-domain, tunnels under it"
  local js dom
  js="$(burrow_call GET /cf)" || die "$js"
  dom="$(printf '%s' "$js" | jget domain.mainHost)"
  if [ -n "$dom" ]; then ok "linked: https://$dom  ${DIM}(another name: aegis domain rename NAME)${NC}"; return 0; fi
  if [ "$(printf '%s' "$js" | jget cloudflared)" != true ]; then say "needs cloudflared: run aegis doctor --fix, then aegis domain link"; return 0; fi
  if confirm "Link a domain now?" n; then domain_link; else dim "Later: aegis domain link (or Settings → Domain in the browser)"; fi
}

domain_link() {
  local js out url zone label
  js="$(burrow_call GET /cf)" || die "$js"
  if [ -z "$(printf '%s' "$js" | jget cert)" ]; then
    spin_start "asking Cloudflare for an authorization link"
    out="$(burrow_call POST /cf/login)" || { spin_stop; die "$out"; }
    spin_stop
    url="$(printf '%s' "$out" | jget url)"
    printf '\n  Open this in any browser (your phone works), sign in to Cloudflare and pick your domain:\n\n    %s%s%s\n\n' "$B$MNT" "$url" "$NC"
    open_url "$url"
    spin_start "waiting for you to authorize (ctrl-c stops)"
    if ! zone="$(cli cf-wait 2>&1)"; then spin_stop; burrow_call POST /cf/cancel >/dev/null 2>&1 || true; die "Cloudflare: $zone"; fi
    spin_stop
    ok "Cloudflare authorized for ${B}${zone:-your zone}${NC}"
  else
    zone="$(printf '%s' "$js" | jget cert.zone.name)"
    ok "Cloudflare is authorized for ${B}${zone:-your zone}${NC}"
  fi
  while :; do
    label="$(ask "The dashboard's subdomain (any name you like)" aegis | tr 'A-Z' 'a-z')"
    if ! [[ "$label" =~ ^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$ ]]; then bad "1-40 letters, digits and dashes (not at the ends)"; continue; fi
    spin_start "linking $label.${zone:-your zone}"
    if out="$(burrow_call POST /cf/link "{\"label\":\"$label\"}")"; then spin_stop; break; fi
    spin_stop; bad "$out"
    confirm "Try another name?" y || return 0
  done
  ok "the dashboard is at ${B}${MNT}https://$(printf '%s' "$out" | jget domain.mainHost)${NC}  ${DIM}(it can take a minute to resolve)${NC}"
}

# ---------------------------------------------------------------- aegis domain
cmd_domain() {
  need_installed; ensure_running
  local js dom label out
  js="$(burrow_call GET /cf)" || die "$js"
  dom="$(printf '%s' "$js" | jget domain.mainHost)"
  case "${1:-}" in
    link) [ -z "$dom" ] || die "already linked: $dom (another name: aegis domain rename NAME)"; domain_link ;;
    rename)
      [ -n "$dom" ] || die "no domain yet: aegis domain link"
      label="${2:-}"
      [ -n "$label" ] || label="$(ask "New subdomain for the dashboard" "$(printf '%s' "$js" | jget domain.label)")"
      confirm "Move the dashboard from $dom to $label.$(printf '%s' "$js" | jget domain.zone)? The old address stops working." y || return 0
      spin_start "renaming"
      out="$(burrow_call POST /cf/rename "{\"label\":\"$(printf '%s' "$label" | tr 'A-Z' 'a-z')\"}")" || { spin_stop; die "$out"; }
      spin_stop
      ok "the dashboard is now at ${B}${MNT}https://$(printf '%s' "$out" | jget domain.mainHost)${NC}; sign in there again" ;;
    unlink)
      [ -n "$dom" ] || die "no domain is linked"
      confirm "Unlink $dom? Its DNS records and Cloudflare tunnel are deleted; tunnels go back to trycloudflare.com names." n || return 0
      spin_start "unlinking"; out="$(burrow_call POST /cf/unlink)" || { spin_stop; die "$out"; }; spin_stop
      ok "unlinked $dom" ;;
    "")
      if [ -n "$dom" ]; then
        title "Domain"
        linkline domain "https://$dom/"
        say "$([ "$(printf '%s' "$js" | jget domain.managed)" = true ] && echo "Aegis runs its cloudflared (post-quantum)" || echo "routed by your own cloudflared service")"
        if interactive && confirm "Give the dashboard another name?" n; then cmd_domain rename; fi
      else
        title "Domain" "none linked yet"
        if interactive; then domain_link; else say "link one: aegis domain link"; fi
      fi ;;
    *) die "aegis domain [link | rename NAME | unlink]" ;;
  esac
}

# ---------------------------------------------------------------- aegis passwd
cmd_passwd() {
  need_installed; ensure_running
  interactive || die "aegis passwd asks questions: run it in a terminal"
  setup_needed && { cmd_setup; return 0; }
  title "A new login" "every browser that's signed in is signed out"
  local u p p2 out
  while :; do u="$(ask "Username" "$(setting auth.username)")"; [[ "$u" =~ ^[A-Za-z0-9._@-]{2,64}$ ]] && break; bad "2-64 letters, digits, . _ @ -"; done
  while :; do
    p="$(ask_secret "New password (10+ characters)")"
    if [ "${#p}" -lt 10 ]; then bad "use at least 10 characters"; continue; fi
    p2="$(ask_secret "The same again")"
    [ "$p" = "$p2" ] && break
    bad "the two differ; once more"
  done
  out="$(U="$u" P="$p" "$NODE" -e 'process.stdout.write(JSON.stringify({username: process.env.U, password: process.env.P}))' | burrow_call POST /password -)" || die "$out"
  p=""; p2=""
  ok "the login is now ${B}$u${NC}; every browser signs in again"
}

# ---------------------------------------------------------------- aegis open
cmd_open() {
  need_installed
  if setup_needed; then title "Set it up" "create the login in a browser, or: aegis setup"; links "$(setup_path)"
  else title "The dashboard"; links ""; fi
  open_url "$(dashboard_url)"
}

# ---------------------------------------------------------------- aegis tunnels
cmd_tunnels() {
  need_installed; ensure_running
  if ! interactive; then cmd_burrow list; return 0; fi
  local rows ch line
  while :; do
    rows="$(cli tunnels)" || die "$rows"
    local -a items=($'new\t+ Publish a port\tpick from what is listening here')
    while IFS= read -r line; do [ -n "$line" ] && items+=("$line"); done <<<"$rows"
    items+=($'back\tBack\t')
    printf '\n'
    ch="$(menu_choose "Tunnels" "${items[@]}")" || return 0
    case "$ch" in
      back) return 0 ;;
      new) tunnel_new ;;
      *) tunnel_one "$ch" ;;
    esac
  done
}

tunnel_new() {
  local rows ch line port host name sub access=login out
  spin_start "looking for listening ports"
  rows="$(cli ports)" || { spin_stop; bad "$rows"; return 0; }
  spin_stop
  local -a items=()
  while IFS= read -r line; do [ -n "$line" ] && items+=("$line"); done <<<"$rows"
  items+=($'other\tAnother port\ttype it, or one on another machine')
  ch="$(menu_choose "Which port?" "${items[@]}")" || return 0
  if [ "$ch" = other ]; then port="$(ask "Port")"; host="$(ask "On which host" 127.0.0.1)"
  else port="${ch%%:*}"; host="${ch#*:}"; fi
  [[ "$port" =~ ^[0-9]{1,5}$ ]] || { bad "that isn't a port"; return 0; }
  name="$(ask "Name (optional)")"
  sub="$(ask "Its own subdomain (optional, like grafana)")"
  confirm "Public, with no login?" n && access=public
  spin_start "publishing $port"
  out="$(PORT="$port" H="$host" N="$name" S="$sub" A="$access" "$NODE" -e '
    const e = process.env;
    process.stdout.write(JSON.stringify({ port: +e.PORT, targetHost: e.H, targetPort: +e.PORT, name: e.N, sub: e.S || null, access: e.A }));' | burrow_call POST /tunnels -)" || { spin_stop; bad "$out"; return 0; }
  spin_stop
  ok "tunnel-$port is live: ${B}${MNT}$(printf '%s' "$out" | jget url)${NC}"
}

tunnel_one() {
  local port="$1" js url access enabled sub ch out
  while :; do
    js="$(burrow_call GET "/tunnels/$port")" || { bad "$js"; return 0; }
    url="$(printf '%s' "$js" | jget url)"; access="$(printf '%s' "$js" | jget access)"
    enabled="$(printf '%s' "$js" | jget enabled)"; sub="$(printf '%s' "$js" | jget sub)"
    title "tunnel-$port  $(printf '%s' "$js" | jget name)" "→ $(printf '%s' "$js" | jget target)"
    linkline address "${url:-on its way}"
    say "$access · $([ "$enabled" = true ] && echo live || echo paused) · $(printf '%s' "$js" | jget totals.requests) requests · $(printf '%s' "$js" | jget clients) clients"
    printf '\n'
    local -a items=(
      $'sub\tChange its address\t'"${sub:+now }${sub:-its own subdomain, like grafana}"
      "access"$'\t'"$([ "$access" = public ] && echo "Require the login" || echo "Make it public")"$'\t'"$([ "$access" = public ] && echo "anyone can open it now" || echo "no login needed after this")"
      "pause"$'\t'"$([ "$enabled" = true ] && echo "Pause it" || echo "Resume it")"$'\t'"$([ "$enabled" = true ] && echo "stops answering, kept" || echo "answers again")"
      $'open\tOpen it\tin this machine\'s browser'
      $'remove\tUnpublish\tits address goes away'
      $'back\tBack\t')
    ch="$(menu_choose "What now?" "${items[@]}")" || return 0
    case "$ch" in
      back) return 0 ;;
      sub) local s; s="$(ask "Subdomain (empty: back to tunnel-$port-…)" "$sub")"
           out="$(S="$s" "$NODE" -e 'process.stdout.write(JSON.stringify({sub: process.env.S || null}))' | burrow_call PATCH "/tunnels/$port" -)" && ok "now at $(printf '%s' "$out" | jget url)" || bad "$out" ;;
      access) out="$(burrow_call PATCH "/tunnels/$port" "{\"access\":\"$([ "$access" = public ] && echo login || echo public)\"}")" && ok "done" || bad "$out" ;;
      pause) out="$(burrow_call PATCH "/tunnels/$port" "{\"enabled\":$([ "$enabled" = true ] && echo false || echo true)}")" && ok "done" || bad "$out" ;;
      open) open_url "$url"; say "$url" ;;
      remove) confirm "Unpublish tunnel-$port?" n && { out="$(burrow_call DELETE "/tunnels/$port")" && ok "tunnel-$port removed" || bad "$out"; return 0; } ;;
    esac
  done
}

# ---------------------------------------------------------------- aegis update
cmd_update() {
  need_installed
  case "${1:-}" in auto) cmd_auto "${2:-}"; return $? ;; esac
  running || { update_offline "$@"; return $?; }
  local out cur latest
  spin_start "asking GitHub for the newest version"
  out="$(burrow_call POST /update/check)" || { spin_stop; die "$out"; }
  spin_stop
  cur="$(printf '%s' "$out" | jget current)"; latest="$(printf '%s' "$out" | jget latest)"
  if [ "$(printf '%s' "$out" | jget available)" != true ]; then
    local err; err="$(printf '%s' "$out" | jget error)"
    [ -n "$err" ] && die "$err"
    ok "up to date (v$cur)"; return 0
  fi
  title "Update available  ${MNT}v$cur → v$latest${NC}" "what's new"
  cli whats-new || true
  echo
  [ "${1:-}" = "--check" ] && { say "install it: aegis update"; return 0; }
  if interactive && ! confirm "Install v$latest now? Aegis restarts for a few seconds; everything you set up is kept." y; then return 0; fi
  spin_start "downloading and installing v$latest"
  out="$(burrow_call POST /update/apply)" || { spin_stop; die "$out"; }
  spin_stop
  ok "installed v$latest"
  if [ "$(service_scope)" = manual ]; then warn "restart it with whatever runs it to finish"; return 0; fi
  spin_start "restarting"
  if cli update-wait "$latest"; then spin_stop; ok "v$latest is running"; else spin_stop; warn "not answering yet; see: aegis status"; fi
}
cmd_auto() {
  need_installed; ensure_running
  local out
  case "${1:-}" in
    on|off) out="$(burrow_call POST /prefs "{\"autoUpdate\":$([ "$1" = on ] && echo true || echo false)}")" || die "$out"
            ok "updates $([ "$1" = on ] && echo "install by themselves" || echo "wait for you")" ;;
    *) die "aegis update auto on | off" ;;
  esac
}
# not running: the newest code from GitHub, installed with its own bin/aegis
update_offline() {
  local repo="${AEGIS_REPO:-alexd-aero/aegis-burrow}" cur latest tmp src
  cur="$(app_version)"
  latest="$(curl -fsSL "https://raw.githubusercontent.com/$repo/main/package.json" | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' | head -1)"
  [ -n "$latest" ] || die "could not reach GitHub"
  if [ "$cur" = "$latest" ] || ver_ge "$cur" "$latest"; then ok "up to date (v$cur)"; return 0; fi
  info "update available: v$cur → v$latest"
  [ "${1:-}" = "--check" ] && return 0
  tmp="$(mktemp -d)"
  spin_start "downloading v$latest"
  curl -fsSL "https://codeload.github.com/$repo/tar.gz/refs/heads/main" | tar -xz -C "$tmp" || { spin_stop; rm -rf "$tmp"; die "download failed"; }
  spin_stop
  src="$(ls -d "$tmp"/*/ | head -1)"
  [ -x "$src/bin/aegis" ] && [ -f "$src/aegis/server.mjs" ] || { rm -rf "$tmp"; die "the download does not look like Aegis × Burrow"; }
  AEGIS_HOME="$AEGIS_HOME" "$src/bin/aegis" upgrade --setup browser || { rm -rf "$tmp"; die "upgrade failed"; }
  rm -rf "$tmp"
}

# ---------------------------------------------------------------- the home screen
cmd_home() {
  need_installed
  banner "$(app_version)"
  local ch
  while :; do
    local UP=0 SETUP=0 USER_NAME="" DASH="" LOCAL="" SERVEO="" SERVEO_ON=0 DOMAIN="" DOMAIN_MANAGED=0 BURROW_ON=0 TUNNELS=0
    local TERMIX=0 FORGE=0 UPD=0 UPD_TO="" AUTO_UPD=0 PACK_DECIDED=0 VERSION=""
    eval "$(cli vars)"
    cli status || true
    printf '\n'
    local -a items=()
    if [ "$UP" != 1 ]; then
      items+=($'start\tStart Aegis × Burrow\tit is not running')
      items+=($'logs\tShow the log\tthe last lines, to see why')
      items+=($'doctor\tCheck this machine\tNode.js, cloudflared, Docker')
    else
      if [ "$SETUP" = 1 ]; then
        items+=($'setup\tSet it up here\tthe login, then the pack and a domain')
        items+=($'links\tSet it up in a browser\tthe setup links, for this machine or your phone')
      fi
      [ "$UPD" = 1 ] && items+=("update"$'\t'"Update to v$UPD_TO"$'\t'"a few seconds; everything is kept")
      items+=("open"$'\t'"Open the dashboard"$'\t'"$DASH")
      [ "$BURROW_ON" = 1 ] && items+=("tunnels"$'\t'"Tunnels"$'\t'"$TUNNELS published · publish, rename, make public")
      if [ -n "$DOMAIN" ]; then items+=("domain"$'\t'"Domain"$'\t'"$DOMAIN · give it another name")
      else items+=($'domain\tLink your own domain\tCloudflare: NAME.your-domain'); fi
      if [ "$SETUP" != 1 ]; then
        items+=($'pack\tThe pack\tTermix, Selkies Forge, Burrow')
        items+=($'passwd\tChange the login\tevery browser signs in again')
      fi
      if [ "$SERVEO_ON" = 1 ]; then items+=("serveooff"$'\t'"Turn the serveo link off"$'\t'"${SERVEO:-connecting…}")
      else items+=($'serveoon\tTurn the serveo link on\ta public link, no account needed'); fi
      if [ "$BURROW_ON" = 1 ]; then items+=($'burrowoff\tSwitch Burrow off\ttunnels stop answering; they are kept')
      else items+=($'burrowon\tSwitch Burrow on\ttunnels answer again'); fi
      [ "$UPD" = 1 ] || items+=($'check\tCheck for updates\ton GitHub')
      if [ "$AUTO_UPD" = 1 ]; then items+=($'autooff\tStop updating by itself\tauto-update is on')
      else items+=($'autoon\tUpdate by itself\tinstall new versions as they come out'); fi
      items+=($'restart\tRestart\ta few seconds')
      items+=($'logs\tShow the log\tthe last lines')
      items+=($'doctor\tCheck this machine\tNode.js, cloudflared, Docker')
    fi
    items+=($'quit\tQuit\t')
    ch="$(menu_choose "What would you like to do?" "${items[@]}")" || { printf '\n  %sbye%s\n\n' "$DIM" "$NC"; return 0; }
    printf '\n'
    case "$ch" in
      start) svc start; if wait_healthy; then ok "started"; else warn "not answering yet"; fi ;;
      setup) cmd_setup; pause ;;
      links) title "Set it up in a browser"; links "$(setup_path)"; pause ;;
      update) cmd_update; pause ;;
      open) cmd_open; pause ;;
      tunnels) cmd_tunnels ;;
      domain) cmd_domain; pause ;;
      pack) setup_pack; pause ;;
      passwd) cmd_passwd; pause ;;
      serveoon|serveooff)
        out="$(burrow_call POST /serveo "{\"on\":$([ "$ch" = serveoon ] && echo true || echo false)}")" || bad "$out"
        if [ "$ch" = serveoon ]; then spin_start "opening the serveo link"; wait_serveo || true; spin_stop; fi ;;
      burrowon) cmd_burrow on ;;
      burrowoff) confirm "Switch Burrow off? Tunnels stop answering until it's back on." n && cmd_burrow off ;;
      check) cmd_update --check; pause ;;
      autoon) cmd_auto on ;;
      autooff) cmd_auto off ;;
      restart) spin_start "restarting"; svc restart >/dev/null 2>&1 || true; spin_stop; if wait_healthy; then ok "restarted"; else warn "not answering yet"; fi ;;
      logs) cmd_logs 2>&1 | tail -n 25; pause ;;
      doctor) cmd_doctor || true; pause ;;
      quit) printf '  %sbye%s\n\n' "$DIM" "$NC"; return 0 ;;
    esac
  done
}

usage() {
  banner "$(src_version)"
  cat <<USAGE
  ${B}Get going${NC}
    aegis                        the home screen: what's running, what to do next
    aegis setup                  set it up here: your login, the pack, a domain
    aegis open                   the dashboard's links (and open it, on a desktop)

  ${B}Every day${NC}
    aegis status [--json]        what is running, where, and what's new
    aegis tunnels                manage tunnels with the arrow keys
    aegis domain [link | rename NAME | unlink]
    aegis passwd                 a new login (every browser signs in again)
    aegis update [--check]       the newest version from GitHub
    aegis update auto on|off     install new versions by themselves
    aegis start | stop | restart | logs [-f]

  ${B}Burrow, the tunnel engine${NC}  (also: burrow …)
    aegis burrow status | list | on | off
    aegis burrow publish PORT [--name N] [--sub NAME] [--public] [--host H]
    aegis burrow rename PORT NAME | unpublish PORT

  ${B}More${NC}
    aegis serveo on | off | url  a public link to the dashboard, no account
    aegis termix install | remove
    aegis doctor [--fix]         check (and fetch) Node.js and cloudflared
    aegis url | setup-link | version
    aegis install [--port N] [--bind ADDR] [--home DIR] [--termix] [--no-start] [--setup cli|browser]
    aegis upgrade                copy this checkout over the installed copy, restart
    aegis uninstall [--purge]

USAGE
}

need_installed() { [ -f "$APP/aegis/server.mjs" ] || die "Aegis × Burrow is not installed (run: aegis install)"; NODE="$(find_node)" || die "Node.js is missing"; }

# no command: the home screen in a terminal, the help elsewhere
if [ $# -eq 0 ]; then
  if [ -f "$APP/aegis/server.mjs" ] && interactive; then set -- home; else set -- help; fi
fi
case "$1" in
  home) need_installed; cmd_home ;;
  setup) need_installed; cmd_setup ;;
  open) need_installed; cmd_open ;;
  tunnels) need_installed; cmd_tunnels ;;
  domain) shift; need_installed; cmd_domain "$@" ;;
  passwd|password) need_installed; cmd_passwd ;;
  install) shift; cmd_install "$@" ;;
  upgrade) shift; cmd_install "$@" ;;
  update) shift; need_installed; cmd_update "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  start|stop|restart) need_installed; svc "$1"; [ "$1" = stop ] || wait_healthy || die "not answering yet; see: aegis logs"; ok "$1 done" ;;
  status) shift; cmd_status "$@" ;;
  url) need_installed; links "" ;;
  setup-link) need_installed; if setup_needed; then links "$(setup_path)"; else echo "  the login is already set up:"; links ""; fi ;;
  serveo) shift; need_installed
    case "${1:-url}" in
      on|off) out="$(burrow_call POST /serveo "{\"on\":$([ "$1" = on ] && echo true || echo false)}")" || die "$out"
              ok "serveo link $1"; [ "$1" = on ] && { wait_serveo && links "" || say "still connecting; see: aegis serveo url"; } ;;
      url) s="$(serveo_url)"; if [ -n "$s" ]; then echo "$s"; elif serveo_wanted; then die "not up yet (ssh to serveo.net still connecting, or blocked)"; else die "off: aegis serveo on"; fi ;;
      *) die "aegis serveo on | off | url" ;;
    esac ;;
  logs) shift; cmd_logs "$@" ;;
  termix) shift; need_installed; cmd_termix "$@" ;;
  burrow) shift; need_installed; cmd_burrow "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  version|-v|--version) src_version ;;
  help|-h|--help) usage ;;
  *) die "unknown command $1 (see: aegis help)" ;;
esac
